name = "gsuite-mcp-gateway"
main = "src/index.ts"
compatibility_date = "2026-05-09"

[[d1_databases]]
binding = "DB"
database_name = "gsuite_mcp_gateway"
database_id = "YOUR_D1_DATABASE_ID"
preview_database_id = "YOUR_D1_PREVIEW_DATABASE_ID"

[vars]
APP_ENV = "production"
OAUTH_ISSUER = "https://YOUR-WORKER.your-subdomain.workers.dev"
MCP_RESOURCE = "https://YOUR-WORKER.your-subdomain.workers.dev/mcp"
MCP_AUDIENCE = "https://YOUR-WORKER.your-subdomain.workers.dev/mcp"
GOOGLE_CALLBACK_URL = "https://YOUR-WORKER.your-subdomain.workers.dev/oauth/google/callback"
GOOGLE_CALENDAR_WRITE_SCOPE_MODE = "all"
AUTH_STORAGE_MODE = "d1"
DEFAULT_TIME_ZONE = "Europe/Amsterdam"
ACCESS_TOKEN_TTL_SECONDS = "3600"
AUTH_CODE_TTL_SECONDS = "180"
REFRESH_TOKEN_TTL_SECONDS = "2592000"
STATE_TTL_SECONDS = "1200"
REDIRECT_URI_ALLOWLIST = "https://YOUR-CLIENT.example/oauth/callback"
ALLOWED_ORIGINS = "https://YOUR-CLIENT.example"
